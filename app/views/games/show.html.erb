<div class="main-container" style="max-width: 800px;">
  <header class="game-header">
    <h1 class="game-title">⚔️ ИДЁТ СРАЖЕНИЕ ⚔️</h1>
    <p class="game-subtitle">Игра #<%= @game.id %> | Капитан: <span class="nickname"><%= @current_user&.nickname || "Гость" %></span></p>
  </header>

  <main class="game-content" style="display: flex; flex-direction: column; align-items: center; gap: 30px;">
    
    <div class="grid-wrapper">
      <h4 style="margin-bottom: 15px; color: #fff; text-align: center;">🔥 Квадрат ведения огня (Поле соперника) 🔥</h4>
      <p style="color: #94a3b8; font-size: 0.85rem; text-align: center; margin-top: -10px; margin-bottom: 20px;">Нажмите на любую клетку, чтобы произвести выстрел</p>
      
      <div class="sea-battle-grid">
        <!-- Буквенная строка координат -->
        <div class="coord"></div>
        <% ["А", "Б", "В", "Г", "Д", "Е", "Ж", "З", "И", "К"].each do |letter| %>
          <div class="coord"><%= letter %></div>
        <% end %>
        
        <!-- Генерируем сетку 10х10 через циклы Ruby -->
        <% (1..10).each do |y| %>
          <div class="coord"><%= y %></div> <!-- Номер ряда в начале строки -->
          
          <% (1..10).each do |x| %>
            <% # Проверяем, стрелял ли уже игрок в эту клетку в текущем матче %>
            <% existing_move = @moves.find { |m| m.x == x && m.y == y } %>
            
            <% if existing_move %>
              <!-- Если выстрел уже был, рисуем закрашенную клетку с его статусом -->
              <div class="game-cell <%= existing_move.status %>" style="cursor: default;"></div>
            <% else %>
              <!-- Если выстрела не было, клетка является кнопкой-формой для выстрела -->
              <form action="<%= game_moves_path(@game) %>" method="post" style="margin: 0; padding: 0; display: block; width: 100%; height: 100%;">
                <input type="hidden" name="x" value="<%= x %>">
                <input type="hidden" name="y" value="<%= y %>">
                <button type="submit" class="game-cell" style="width: 100%; height: 100%; padding: 0; margin: 0; background: transparent; display: block; box-sizing: border-box;"></button>
              </form>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div style="margin-top: 10px;">
      <a href="/" class="btn btn-secondary">🚪 Вернуться в штаб (На главную)</a>
    </div>

  </main>
</div>
