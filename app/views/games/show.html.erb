<div class="main-container" style="max-width: 1100px;">
  <header class="game-header">
    <h1 class="game-title">⚔️ МОРСКОЙ БОЙ: PVP ⚔️</h1>
    <p class="game-subtitle">Комната #<%= @game.id %> | Капитан: <span class="nickname"><%= @current_user&.nickname || "Гость" %></span></p>
  </header>

  <main class="game-content" style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
    <%= render "games/board", game: @game, current_user: @current_user %>

    <div style="margin-top: 10px;">
      <a href="/" class="btn btn-secondary">🚪 Вернуться в штаб</a>
    </div>
  </main>
</div>

<script>
  setInterval(function() {
    const board = document.getElementById("game_board_user_<%= @current_user&.id %>");
    // Обновляем доску в фоне только если ждём соперника или сейчас не наш ход (нет активных кнопок для выстрела)
    if (board && board.querySelectorAll("button.game-cell").length === 0) {
      fetch(window.location.href, { headers: { "Accept": "text/html" } })
        .then(r => r.text())
        .then(html => {
          const doc = new DOMParser().parseFromString(html, "text/html");
          const freshBoard = doc.getElementById("game_board_user_<%= @current_user&.id %>");
          if (freshBoard) {
            board.replaceWith(freshBoard);
          }
        });
    }
  }, 1000);
</script>
