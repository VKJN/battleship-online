<h2>Войти в игру</h2>

<form action="/session" method="post">
  <div>
    <label for="nickname">Введите ваш никнейм</label><br>
    <input type="text" name="nickname" id="nickname" required autofocus value="<%= params[:nickname] %>">
  </div>
  <br>
  <div>
    <label for="password">Пароль</label><br>
    <input type="password" name="password" id="password" required>
  </div>
  <br>
  <div>
    <button type="submit">Войти</button>
  </div>
</form>

<br>
<p>Впервые тут? <a href="/register">Создать новый аккаунт</a></p>
