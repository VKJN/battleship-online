<div class="auth-container">
  <h2>Войти в игру</h2>

  <form action="/session" method="post">
    <div class="form-group">
      <label for="nickname">Ваш никнейм</label>
      <input type="text" name="nickname" id="nickname" required autofocus>
    </div>
    
    <div class="form-group">
      <label for="password">Пароль</label>
      <input type="password" name="password" id="password" required>
    </div>
    
    <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">Войти</button>
  </form>

  <p class="auth-switch-text">
    Впервые тут? <a href="/register">Создать новый аккаунт</a>
  </p>
</div>
