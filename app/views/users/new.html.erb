<h2>Регистрация нового игрока</h2>

<% if @user.errors.any? %>
  <div style="color: red;">
    <h4>Ошибки при регистрации:</h4>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<form action="/register" method="post">
  <div>
    <label for="user_nickname">Придумайте никнейм</label><br>
    <input type="text" name="user[nickname]" id="user_nickname" required autofocus>
  </div>
  <br>
  <div>
    <label for="user_password">Пароль</label><br>
    <input type="password" name="user[password]" id="user_password" required>
  </div>
  <br>
  <div>
    <label for="user_password_confirmation">Повторите пароль</label><br>
    <input type="password" name="user[password_confirmation]" id="user_password_confirmation" required>
  </div>
  <br>
  <div>
    <button type="submit">Создать аккаунт</button>
  </div>
</form>
<br>
<p>Уже есть аккаунт? <a href="/session/new">Войти в игру</a></p>